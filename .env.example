# HTTP port for the API
PORT=3000

# Proxies whose X-Forwarded-For to believe for the client address the audit trail records (Express "trust proxy").
# Unset trusts none. A hop count (1 behind one load balancer), addresses/CIDRs/loopback comma-separated, or true.
TRUST_PROXY=

# Elasticsearch. Local dev: the docker-compose node, no auth.
ES_NODE=http://localhost:9200
# Elastic Cloud: set ES_CLOUD_ID (or ES_NODE) plus ES_API_KEY. Basic auth is also supported.
ES_CLOUD_ID=
ES_API_KEY=
ES_USERNAME=
ES_PASSWORD=

# Seed: the date health/overdue/history are computed "as of" (YYYY-MM-DD). Defaults to today.
SEED_AS_OF=
